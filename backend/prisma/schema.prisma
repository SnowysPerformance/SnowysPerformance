generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum WearableSource {
  WHOOP
  HEALTHKIT
  GARMIN
}

// FULL = can see and edit every athlete on the team (the default — every
// coach had this before co-coach permissions existed). RESTRICTED = can
// still SEE every athlete's plans/progress, but can only create, change or
// delete a workout/test/profile/plan-assignment for an athlete they've
// been explicitly granted (see CoachAthleteAccess).
enum CoachAccessLevel {
  FULL
  RESTRICTED
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  programs Program[]
  exerciseLibrary ExerciseLibraryItem[]
  testTypeLibrary TestTypeLibraryItem[]
  invites  Invite[]
  messages Message[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())

  accessLevel  CoachAccessLevel @default(FULL)
  isHeadCoach  Boolean          @default(false)
  isPlatformAdmin Boolean       @default(false)
  suspended    Boolean          @default(false)

  injuryHistory String? @db.Text
  needsAnalysis String? @db.Text
  archetype     String? @db.Text
  generalNotes  String? @db.Text

  workoutLogs         WorkoutLog[]
  testResults         TestResult[]
  wearableData        WearableData[]
  wearableAccountLinks WearableAccountLink[]
  createdPrograms     Program[]            @relation("ProgramCreator")
  programAssignments  ProgramAssignment[]
  sentInvites         Invite[]
  athleteAccessGrants CoachAthleteAccess[] @relation("CoachAccessCoach")
  grantedToCoaches    CoachAthleteAccess[] @relation("CoachAccessAthlete")
  athleteMessages     Message[]            @relation("MessageThreadAthlete")
  sentMessages        Message[]            @relation("MessageSender")
}

model Program {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  createdById String
  createdBy   User     @relation("ProgramCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  phases      ProgramPhase[]
  weeks       ProgramWeek[]
  assignments ProgramAssignment[]
}

model ProgramPhase {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  weeks     Int?
  goal      String?
  order     Int      @default(0)

  microcycles ProgramWeek[]
}

model ProgramWeek {
  id         String        @id @default(uuid())
  programId  String
  program    Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  phaseId    String?
  phase      ProgramPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  weekNumber Int
  name       String?
  startDate  DateTime?

  days ProgramDay[]
}

model ProgramDay {
  id        String      @id @default(uuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  label     String?
  name      String?

  exercises ProgramExercise[]
}

model ProgramExercise {
  id           String     @id @default(uuid())
  dayId        String
  day          ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseName String
  type         String   @default("weighted")
  mode         String   @default("percent")
  sets         Int?
  reps         Int?
  percentOfMax Float?
  weight       Float?
  goalBarSpeed Float?
  methodName   String?
  band         String?
  distance     String?
  resisted     Boolean  @default(false)
  resistance   String?
  restSeconds  String?
  isWarmup     Boolean  @default(false)
  isTest       Boolean  @default(false)
  testUnit     String?
  groupId      String?
  groupLabel   String?
  order        Int      @default(0)
  notes        String?
}

model WorkoutLog {
  id           String   @id @default(uuid())
  teamId       String
  athleteId    String
  athlete      User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date         DateTime
  label        String?
  exerciseName String
  type         String   @default("weighted")
  methodName   String?
  band         String?
  distance     String?
  resisted     Boolean  @default(false)
  resistance   String?
  restSeconds  String?
  isWarmup     Boolean  @default(false)
  isTest       Boolean  @default(false)
  sets         Json
  volumeLoad   Float
  notes        String?
  createdAt    DateTime @default(now())
}

model TestResult {
  id        String   @id @default(uuid())
  teamId    String
  athleteId String
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  testType  String
  value     Float
  unit      String
  date      DateTime
  createdAt DateTime @default(now())
}

model WearableData {
  id         String         @id @default(uuid())
  teamId     String
  athleteId  String
  athlete    User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source     WearableSource
  date       DateTime
  recovery   Float?
  strain     Float?
  sleepScore Float?
  restingHR  Float?
  raw        Json?
  createdAt  DateTime       @default(now())
}

model WearableAccountLink {
  id             String         @id @default(uuid())
  athleteId      String
  athlete        User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source         WearableSource
  externalUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime       @default(now())

  @@unique([source, externalUserId])
}

model ProgramAssignment {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([programId, athleteId])
}

model ExerciseLibraryItem {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  regressions  Json?
  progressions Json?
  createdAt    DateTime @default(now())

  @@unique([teamId, name])
}

model TestTypeLibraryItem {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  unit      String   @default("")
  createdAt DateTime @default(now())

  @@unique([teamId, name])
}

model Invite {
  id          String    @id @default(uuid())
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(ATHLETE)
  newTeam     Boolean   @default(false)
  accessLevel      CoachAccessLevel @default(FULL)
  athleteAccessIds Json?
