generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

enum Role {
COACH
ATHLETE
}

enum WearableSource {
WHOOP
HEALTHKIT
GARMIN
}

enum CoachAccessLevel {
FULL
RESTRICTED
}

model Team {
id String @id @default(uuid())
name String
createdAt DateTime @default(now())
users User[]
programs Program[]
exerciseLibrary ExerciseLibraryItem[]
testTypeLibrary TestTypeLibraryItem[]
invites Invite[]
messages Message[]
teamMemberships TeamMembership[]
}

model User {
id String @id @default(uuid())
email String @unique
passwordHash String
name String
role Role
teamId String
team Team @relation(fields: [teamId], references: [id])
createdAt DateTime @default(now())
accessLevel CoachAccessLevel @default(FULL)
isHeadCoach Boolean @default(false)
isPlatformAdmin Boolean @default(false)
suspended Boolean @default(false)
injuryHistory String? @db.Text
needsAnalysis String? @db.Text
archetype String? @db.Text
generalNotes String? @db.Text
workoutLogs WorkoutLog[]
personalRecords PersonalRecord[]
testResults TestResult[]
wearableData WearableData[]
wearableAccountLinks WearableAccountLink[]
createdPrograms Program[] @relation("ProgramCreator")
programAssignments ProgramAssignment[]
sentInvites Invite[]
athleteAccessGrants CoachAthleteAccess[] @relation("CoachAccessCoach")
grantedToCoaches CoachAthleteAccess[] @relation("CoachAccessAthlete")
athleteMessages Message[] @relation("MessageThreadAthlete")
sentMessages Message[] @relation("MessageSender")
teamMemberships TeamMembership[]

@@index([teamId])
}

model TeamMembership {
id String @id @default(uuid())
userId String
user User @relation(fields: [userId], references: [id], onDelete: Cascade)
teamId String
team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
isHeadCoach Boolean @default(false)
accessLevel CoachAccessLevel @default(FULL)
createdAt DateTime @default(now())

@@unique([userId, teamId])
}

model Program {
id String @id @default(uuid())
teamId String
team Team @relation(fields: [teamId], references: [id])
name String
createdById String
createdBy User @relation("ProgramCreator", fields: [createdById], references: [id])
createdAt DateTime @default(now())
phases ProgramPhase[]
weeks ProgramWeek[]
assignments ProgramAssignment[]

@@index([teamId])
}

model ProgramPhase {
id String @id @default(uuid())
programId String
program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
name String
weeks Int?
goal String?
order Int @default(0)
microcycles ProgramWeek[]

@@index([programId])
}

model ProgramWeek {
id String @id @default(uuid())
programId String
program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
phaseId String?
phase ProgramPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
weekNumber Int
name String?
startDate DateTime?
days ProgramDay[]

@@index([programId])
@@index([phaseId])
}

model ProgramDay {
id String @id @default(uuid())
weekId String
week ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
dayOfWeek Int
label String?
name String?
exercises ProgramExercise[]

@@index([weekId])
}

model ProgramExercise {
id String @id @default(uuid())
dayId String
day ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
exerciseName String
type String @default("weighted")
mode String @default("percent")
sets Int?
reps Int?
duration Int?
percentOfMax Float?
weight Float?
setDetails Json?
goalBarSpeed Float?
methodName String?
band String?
distance String?
resisted Boolean @default(false)
resistance String?
restSeconds String?
isWarmup Boolean @default(false)
isTest Boolean @default(false)
testUnit String?
groupId String?
groupLabel String?
order Int @default(0)
notes String?

@@index([dayId])
}

model WorkoutLog {
id String @id @default(uuid())
teamId String
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
date DateTime
label String?
exerciseName String
type String @default("weighted")
methodName String?
band String?
distance String?
resisted Boolean @default(false)
resistance String?
restSeconds String?
isWarmup Boolean @default(false)
isTest Boolean @default(false)
sets Json
volumeLoad Float
notes String?
createdAt DateTime @default(now())

@@index([athleteId, date])
@@index([teamId])
}

model PersonalRecord {
id String @id @default(uuid())
teamId String
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
exerciseName String
bestWeight Float @default(0)
bestWeightDate DateTime?
bestWeightLogId String?
bestE1rm Float @default(0)
bestE1rmDate DateTime?
bestE1rmLogId String?
updatedAt DateTime @updatedAt

@@unique([athleteId, exerciseName])
}

model TestResult {
id String @id @default(uuid())
teamId String
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
testType String
value Float
unit String
date DateTime
createdAt DateTime @default(now())

@@index([athleteId, date])
@@index([teamId])
}

model WearableData {
id String @id @default(uuid())
teamId String
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
source WearableSource
date DateTime
recovery Float?
strain Float?
sleepScore Float?
restingHR Float?
raw Json?
createdAt DateTime @default(now())

@@index([athleteId, date])
@@index([teamId])
}

model WearableAccountLink {
id String @id @default(uuid())
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
source WearableSource
externalUserId String
accessToken String?
refreshToken String?
accessTokenExpiresAt DateTime?
createdAt DateTime @default(now())

@@unique([source, externalUserId])
@@index([athleteId])
}

model ProgramAssignment {
id String @id @default(uuid())
programId String
program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
athleteId String
athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)
createdAt DateTime @default(now())

@@unique([programId, athleteId])
@@index([athleteId])
}

model ExerciseLibraryItem {
id String @id @default(uuid())
teamId String
team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
name String
regressions Json?
progressions Json?
createdAt DateTime @default(now())

@@unique([teamId, name])
}

model TestTypeLibraryItem {
id String @id @default(uuid())
teamId String
team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
name String
unit String @default("")
createdAt DateTime @default(now())

@@unique([teamId, name])
}

model Invite {
id String @id @default(uuid())
teamId String?
team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
email String
role Role @default(ATHLETE)
newTeam Boolean @default(false)
accessLevel CoachAccessLevel @default(FULL)
athleteAccessIds Json?
token String @unique
invitedById String
invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)
usedAt DateTime?
expiresAt DateTime
createdAt DateTime @default(now())

@@index([teamId])
}

model CoachAthleteAccess {
id String @id @default(uuid())
coachId String
coach User @relation("CoachAccessCoach", fields: [coachId], references: [id], onDelete: Cascade)
athleteId String
athlete User @relation("CoachAccessAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
createdAt DateTime @default(now())

@@unique([coachId, athleteId])
}

model Message {
id String @id @default(uuid())
teamId String
team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
athleteId String
athlete User @relation("MessageThreadAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
senderId String
sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
body String @db.Text
createdAt DateTime @default(now())

@@index([teamId, athleteId])
}
