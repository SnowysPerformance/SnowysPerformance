generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
}

enum WearableSource {
  WHOOP
  HEALTHKIT
  GARMIN
}

// FULL = can see and edit every athlete on the team (the default — every
// coach had this before co-coach permissions existed). RESTRICTED = can
// still SEE every athlete's plans/progress, but can only create, change or
// delete a workout/test/profile/plan-assignment for an athlete they've
// been explicitly granted (see CoachAthleteAccess).
enum CoachAccessLevel {
  FULL
  RESTRICTED
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users    User[]
  programs Program[]
  exerciseLibrary ExerciseLibraryItem[]
  testTypeLibrary TestTypeLibraryItem[]
  invites  Invite[]
  messages Message[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())

  // Only meaningful when role = COACH. Ignored for athletes.
  accessLevel  CoachAccessLevel @default(FULL)
  // Only meaningful when role = COACH. The head coach owns the team — only
  // they can invite/manage assistant coaches, and only the platform admin
  // (see isPlatformAdmin) can invite/suspend/remove a head coach. Set true
  // automatically when someone accepts an admin-sent "new team" invite.
  isHeadCoach  Boolean          @default(false)
  // True only for the one platform-owner account (set via the ADMIN_EMAIL
  // deploy setting, never through any UI) — controls the Admin page.
  isPlatformAdmin Boolean       @default(false)
  // A suspended account can't log in (checked fresh on every request, not
  // just at login, so it takes effect immediately). Only ever set via the
  // Admin page, and only ever applies to the one suspended account itself.
  suspended    Boolean          @default(false)

  // Coach's private notes about an athlete. Only meaningful when
  // role = ATHLETE; never shown to the athlete themselves, only to coaches.
  injuryHistory String? @db.Text
  needsAnalysis String? @db.Text
  archetype     String? @db.Text
  generalNotes  String? @db.Text

  workoutLogs         WorkoutLog[]
  personalRecords     PersonalRecord[]
  testResults         TestResult[]
  wearableData        WearableData[]
  wearableAccountLinks WearableAccountLink[]
  createdPrograms     Program[]            @relation("ProgramCreator")
  programAssignments  ProgramAssignment[]
  sentInvites         Invite[]
  // As a coach: which athletes this coach has been granted edit access to
  // (only checked when this coach's accessLevel is RESTRICTED).
  athleteAccessGrants CoachAthleteAccess[] @relation("CoachAccessCoach")
  // As an athlete: which coaches have been granted edit access to them.
  grantedToCoaches    CoachAthleteAccess[] @relation("CoachAccessAthlete")
  // Chat: as an athlete, the messages in their own thread with the
  // coaching staff; as anyone, the messages they personally sent.
  athleteMessages     Message[]            @relation("MessageThreadAthlete")
  sentMessages        Message[]            @relation("MessageSender")
}

model Program {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  name        String
  createdById String
  createdBy   User     @relation("ProgramCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  phases      ProgramPhase[]
  weeks       ProgramWeek[]
  assignments ProgramAssignment[]
}

model ProgramPhase {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  name      String
  weeks     Int?
  goal      String?
  order     Int      @default(0)

  microcycles ProgramWeek[]
}

model ProgramWeek {
  id         String        @id @default(uuid())
  programId  String
  program    Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  phaseId    String?
  phase      ProgramPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  weekNumber Int
  name       String?
  startDate  DateTime?

  days ProgramDay[]
}

model ProgramDay {
  id        String      @id @default(uuid())
  weekId    String
  week      ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  label     String?
  name      String?

  exercises ProgramExercise[]
}

model ProgramExercise {
  id           String     @id @default(uuid())
  dayId        String
  day          ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseName String
  type         String   @default("weighted")
  mode         String   @default("percent")
  sets         Int?
  reps         Int?
  percentOfMax Float?
  weight       Float?
  // Target bar speed (velocity-based training), in meters/second. Optional —
  // only set when the coach wants a velocity target instead of/alongside a
  // weight or %1RM target.
  goalBarSpeed Float?
  methodName   String?
  band         String?
  distance     String?
  resisted     Boolean  @default(false)
  resistance   String?
  restSeconds  String?
  isWarmup     Boolean  @default(false)
  isTest       Boolean  @default(false)
  testUnit     String?
  groupId      String?
  groupLabel   String?
  order        Int      @default(0)
  notes        String?
}

model WorkoutLog {
  id           String   @id @default(uuid())
  teamId       String
  athleteId    String
  athlete      User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date         DateTime
  label        String?
  exerciseName String
  type         String   @default("weighted")
  methodName   String?
  band         String?
  distance     String?
  resisted     Boolean  @default(false)
  resistance   String?
  restSeconds  String?
  isWarmup     Boolean  @default(false)
  isTest       Boolean  @default(false)
  sets         Json
  volumeLoad   Float
  notes        String?
  createdAt    DateTime @default(now())
}

// One row per athlete + exercise: their current all-time best, kept up to
// date automatically every time a weighted set is logged or deleted (see
// recomputeBests() in workouts.controller.ts) so it can be read instantly
// without re-scanning every workout log they've ever entered.
model PersonalRecord {
  id              String    @id @default(uuid())
  teamId          String
  athleteId       String
  athlete         User      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  exerciseName    String
  // Heaviest single top set ever logged for this exercise.
  bestWeight      Float     @default(0)
  bestWeightDate  DateTime?
  bestWeightLogId String?
  // Best estimated 1-rep max (Epley formula) ever logged for this exercise —
  // can be a different set than bestWeight (e.g. more reps at a lighter load).
  bestE1rm        Float     @default(0)
  bestE1rmDate    DateTime?
  bestE1rmLogId   String?
  updatedAt       DateTime  @updatedAt

  @@unique([athleteId, exerciseName])
}

model TestResult {
  id        String   @id @default(uuid())
  teamId    String
  athleteId String
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  testType  String
  value     Float
  unit      String
  date      DateTime
  createdAt DateTime @default(now())
}

model WearableData {
  id         String         @id @default(uuid())
  teamId     String
  athleteId  String
  athlete    User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source     WearableSource
  date       DateTime
  recovery   Float?
  strain     Float?
  sleepScore Float?
  restingHR  Float?
  raw        Json?
  createdAt  DateTime       @default(now())
}

// Maps a provider's external user id to one of our athletes, once they
// complete that provider's OAuth flow. Webhooks arrive keyed by the
// provider's user id, so this table is what lets us attribute that event.
model WearableAccountLink {
  id             String         @id @default(uuid())
  athleteId      String
  athlete        User           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  source         WearableSource
  externalUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime       @default(now())

  @@unique([source, externalUserId])
}

// Which athlete(s) a program has been assigned to. An athlete only ever
// sees programs that show up here for them — this is what keeps an
// athlete's view scoped to "my prescribed plan" instead of the whole
// team's program library.
model ProgramAssignment {
  id        String   @id @default(uuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([programId, athleteId])
}

// A team-wide shared exercise library, so an exercise name typed once by
// anyone on the team autocompletes everywhere else, and coaches can attach
// easier (regression) or harder (progression) variations to it.
model ExerciseLibraryItem {
  id           String   @id @default(uuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  regressions  Json?
  progressions Json?
  createdAt    DateTime @default(now())

  @@unique([teamId, name])
}

// A team-wide library of test types, seeded by the built-in quick-entry
// presets (Vertical Jump, WHOOP Recovery, etc.) on the frontend and grown
// whenever a coach or athlete logs a "Custom…" test type — after that, it's
// a normal dropdown option for the rest of the team, not something anyone
// has to retype from scratch.
model TestTypeLibraryItem {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  unit      String   @default("")
  createdAt DateTime @default(now())

  @@unique([teamId, name])
}

// A one-time link a coach generates for a specific email address, so only
// someone the coach actually invited can create an athlete login on their
// team — there's no more open "paste in a Team ID" self-registration.
model Invite {
  id          String    @id @default(uuid())
  // Null for a head-coach invite sent by the platform admin — that invite
  // isn't tied to any existing team, since accepting it creates a brand
  // new one. Always set for an athlete or same-team-coach invite.
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email       String
  role        Role      @default(ATHLETE)
  // Only meaningful when role = COACH. true = this invite creates a brand
  // new, separate team (with this person as its sole, full-access coach) —
  // used for "give them a whole separate team, fresh slate" invites.
  // false = they join the inviting coach's own team instead.
  newTeam     Boolean   @default(false)
  // Only meaningful when role = COACH && newTeam = false (a same-team
  // co-coach invite). FULL = can edit every athlete once they join.
  // RESTRICTED = can only edit the athletes listed in athleteAccessIds
  // (chosen by the inviting coach) — they can still see everyone's
  // plans/progress either way.
  accessLevel      CoachAccessLevel @default(FULL)
  athleteAccessIds Json?
  token       String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([teamId])
}

// A grant letting a RESTRICTED coach edit one specific athlete's workouts,
// tests, profile, and plan assignments. A FULL-access coach doesn't need
// any rows here — this table is only ever consulted when the coach's own
// accessLevel is RESTRICTED. Every coach, restricted or not, can already
// VIEW every athlete on the team; this only gates writes.
model CoachAthleteAccess {
  id        String   @id @default(uuid())
  coachId   String
  coach     User     @relation("CoachAccessCoach", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User     @relation("CoachAccessAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([coachId, athleteId])
}

// One shared chat thread per athlete — the athlete talks to "the coaching
// staff," not to one specific coach, and any coach on the team can read or
// reply (same as every coach already being able to see that athlete's
// plans/progress — chat isn't gated by the per-athlete edit permission).
model Message {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   User     @relation("MessageThreadAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([teamId, athleteId])
}
